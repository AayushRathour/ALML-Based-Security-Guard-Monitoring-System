import java.util.*;

public class UserInterface {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.println("Enter the word");
        String word = sc.nextLine();

        System.out.println("Enter the two indices");
        int index1 = sc.nextInt();
        int index2 = sc.nextInt();

        // Index1 must be less than Index2
        if (index1 >= index2) {
            System.out.println("Index2 should be greater than Index1");
        }

        // Index1 must be a valid position in the word
        else if (index1 < 0 || index1 >= word.length()) {
            System.out.println(index1 + " is greater than the word length");
        }

        // Index2 can be equal to word.length() because substring()
        // allows the ending index to be length
        else if (index2 > word.length() || index2 < 0) {
            System.out.println(index2 + " is greater than the word length");
        }

        else {
            System.out.println(word.substring(index1, index2));
        }

        sc.close();
    }
}
