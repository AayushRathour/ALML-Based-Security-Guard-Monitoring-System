package com.capico.service;

import java.util.List;

import org.springframework.stereotype.Service;

import com.capico.entity.User;
import com.capico.repository.UserRepository;

@Service // Marks this class as the service layer.
public class UserService {

    private final UserRepository userRepository;

    // Injects the repository needed for database operations.
    public UserService(UserRepository userRepository) {
        this.userRepository = userRepository;
    }

    // Creates a new user record.
    public User createUser(User user) {
        return userRepository.save(user);
    }

    // Returns all users stored in the database.
    public List<User> getAllUsers() {
        return userRepository.findAll();
    }

    // Finds a user by ID, or returns null if not found.
    public User getUserById(Long id) {
        return userRepository.findById(id).orElse(null);
    }

    // Updates the editable fields of an existing user.
    public User updateUser(Long id, User updatedUser) {
        User existingUser = userRepository.findById(id).orElse(null);

        // Stops the update if the user does not exist.
        if (existingUser == null) {
            return null;
        }

        existingUser.setFirstName(updatedUser.getFirstName());
        existingUser.setLastName(updatedUser.getLastName());
        existingUser.setEmail(updatedUser.getEmail());
        existingUser.setMobileNumber(updatedUser.getMobileNumber());
        existingUser.setCity(updatedUser.getCity());
        existingUser.setState(updatedUser.getState());
        existingUser.setCountry(updatedUser.getCountry());

        return userRepository.save(existingUser);
    }

    // Deletes a user if the ID exists.
    public boolean deleteUser(Long id) {
        if (!userRepository.existsById(id)) {
            return false;
        }

        userRepository.deleteById(id);
        return true;
    }
}
