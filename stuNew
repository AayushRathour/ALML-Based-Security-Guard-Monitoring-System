import java.util.Scanner;
import java.text.SimpleDateFormat;
import java.text.ParseException;
import java.util.Date;
import java.util.Calendar;

public class UserInterface {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.println("Enter the Manufacturing Date");
        String date = sc.nextLine();

        SimpleDateFormat sdf = new SimpleDateFormat("dd/MM/yyyy");
        sdf.setLenient(false);

        Date d;

        // First validate the date
        try {

            // Ensure exact format dd/MM/yyyy
            if (!date.matches("\\d{2}/\\d{2}/\\d{4}")) {
                System.out.println(date + " is not a valid date");
                return;
            }

            d = sdf.parse(date);

        } catch (ParseException e) {

            System.out.println(date + " is not a valid date");
            return;
        }

        // Ask for month ONLY if date is valid
        System.out.println("Enter the Month");
        int month = sc.nextInt();

        // Create Calendar
        Calendar c = Calendar.getInstance();

        // Set manufacturing date
        c.setTime(d);

        // Add validity months
        c.add(Calendar.MONTH, month);

        // Convert Calendar to Date
        Date expiryDate = c.getTime();

        // Convert Date to String
        String result = sdf.format(expiryDate);

        System.out.println(result + " is the expiry date");
    }
}
